# Database Copy Scripts Configuration
# Copy this file to .env and fill in the values
#
# SECURITY: Never commit the .env file to version control!

# ==============================================
# Source Database (Local Development)
# ==============================================
SRC_HOST=localhost
SRC_PORT=5432
SRC_DB=geo_edu_brazil
SRC_USER=your_username

# ==============================================
# Target Database (Production)
# ==============================================
TGT_HOST=your-production-db.postgres.database.azure.com
TGT_PORT=5432
TGT_DB=geo_prod
TGT_USER=your_admin_user
TGT_PASS=your_secure_password

# ==============================================
# Optional: Django settings
# ==============================================
# DJANGO_SECRET_KEY=your-secret-key
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
